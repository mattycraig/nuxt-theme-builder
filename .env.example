# Environment variables for the Nuxt Theme Builder project.
# Copy to .env for local overrides. None are required for `pnpm dev`.

# ─── Launch Gate ─────────────────────────────────────────────────────────
# Enable production launch gating (redirects unauthenticated visitors to /coming-soon)
NUXT_PUBLIC_COMING_SOON_ENABLED=false

# Password required to bypass the coming-soon gate (must be set when gate is enabled)
NUXT_COMING_SOON_PASSWORD=

# ─── Build / Deploy ──────────────────────────────────────────────────────
# Nitro preset (defaults to "vercel"). CI and local production runs use "node-server".
# NITRO_PRESET=node-server

# Token for on-demand ISR revalidation via Vercel bypass
VERCEL_BYPASS_TOKEN=

# AI provider keys are NOT configured here: the AI generator is bring-your-own-key,
# entered by each user in the app UI and sent per request.
