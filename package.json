{
  "name": "nuxt-theme-builder",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check:fonts": "node scripts/check-font-assets.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{json,md,yaml,yml,css}\"",
    "typecheck": "nuxt typecheck",
    "knip": "knip",
    "analyze": "nuxt analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --update-snapshots=missing",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:ci": "playwright test tests/e2e/smoke",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "workflow:quick": "pnpm lint:fix && pnpm format && pnpm typecheck",
    "workflow:full": "pnpm lint:fix && pnpm format && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.62",
    "@ai-sdk/google": "^4.0.79",
    "@ai-sdk/openai": "^4.0.74",
    "@internationalized/date": "^3.12.4",
    "@nuxt/content": "^3.16.1",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/mdc": "^0.23.1",
    "@nuxtjs/sitemap": "^8.5.1",
    "@pinia/nuxt": "^0.11.3",
    "@tiptap/extension-emoji": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/nuxt": "^15.0.0",
    "ai": "^7.0.113",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.16",
    "nuxt": "^4.5.2",
    "nuxt-schema-org": "^6.3.2",
    "nuxt-security": "^2.6.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/lucide": "^1.2.136",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
