{
  "name": "nuxt-theme-builder",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check:fonts": "node scripts/check-font-assets.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{json,md,yaml,yml,css}\"",
    "typecheck": "nuxt typecheck",
    "knip": "knip",
    "analyze": "nuxt analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --update-snapshots=missing",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "workflow:quick": "pnpm lint:fix && pnpm format && pnpm typecheck",
    "workflow:full": "pnpm lint:fix && pnpm format && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.83",
    "@ai-sdk/google": "^4.0.100",
    "@ai-sdk/openai": "^4.0.97",
    "@internationalized/date": "^3.12.4",
    "@nuxt/content": "^3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/sitemap": "^8.6.2",
    "@pinia/nuxt": "^0.11.3",
    "@tiptap/extension-emoji": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "ai": "^7.0.145",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "nuxt": "^4.6.2",
    "nuxt-llms": "^0.2.0",
    "nuxt-schema-org": "^6.4.3",
    "nuxt-security": "^2.6.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert"
        ]
      ],
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "header-max-length": [
        2,
        "always",
        100
      ],
      "body-max-line-length": [
        0
      ]
    }
  },
  "knip": {
    "entry": [
      "app/pages/**/*.vue",
      "app/layouts/**/*.vue",
      "app/middleware/**/*.ts",
      "app/components/**/*.vue",
      "app/composables/**/*.ts",
      "app/stores/**/*.ts",
      "app/utils/**/*.ts",
      "app/types/**/*.ts",
      "app/data/**/*.ts",
      "server/**/*.ts",
      "modules/**/*.ts",
      "shared/**/*.ts",
      "content.config.ts"
    ],
    "project": [
      "app/**/*.{ts,vue}",
      "server/**/*.ts",
      "modules/**/*.ts",
      "shared/**/*.ts"
    ],
    "ignoreDependencies": [
      "@iconify-json/simple-icons",
      "vue-tsc",
      "h3",
      "vitest-environment-nuxt"
    ],
    "paths": {
      "#source-code-map": [
        "server/types/source-code-map.d.ts"
      ]
    },
    "vitest": {
      "entry": [
        "tests/unit/**/*.test.ts"
      ]
    },
    "playwright": {
      "entry": [
        "tests/e2e/**/*.spec.ts"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,vue,mjs}": [
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": false,
    "semi": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 80,
    "endOfLine": "lf"
  }
}
